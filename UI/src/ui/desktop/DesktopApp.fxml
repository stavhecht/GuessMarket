<?xml version="1.0" encoding="UTF-8"?>

<!--
  The desktop app's layout, as Scene Builder can open it, and as the app itself loads it.

  DesktopApp.start reads this file through an FXMLLoader and uses the tree it gets back as
  the scene root, so the window's SHELL is this file and not Java: the file bar, the tab
  pane and the status line below are the real ones. Every fx:id in those three sections is
  the name of an @FXML field in DesktopApp, and the loader fills them in, which is also why
  a rename here has to be matched there by hand. The compiler cannot see into this file, so
  a mismatch shows up as a null at start-up, not as a build error.

  The two tabs' BODIES are a different matter. Most of a screen is generated from the loaded
  market rather than fixed (table rows, the two option cards, the ladder, the chart) so
  EventsScreen and UsersScreen still build themselves in Java, and start() drops each one
  into its tab with setContent. Everything written out inside the two <Tab> elements below
  is therefore a STAND-IN: it is what Scene Builder shows, so the panels can be laid out and
  measured visually, and it is discarded the moment the app replaces it. The fx:ids in those
  sections name fields in EventsScreen / UsersScreen, the class being given in the comment
  above each block, and are documentation only; nothing injects them.

  Three things Scene Builder cannot show, and their stand-ins here:

    * SparkChart is a Pane that paints on a Canvas and takes its height as a constructor
      argument, so it cannot be instantiated from FXML. It appears below as a plain Pane
      with styleClass "chart-slot" at the right height.
    * LmsrPane and OrderBookPane are filled in per event. One representative LMSR option
      card is written out inside the market StackPane so the panel is not an empty box.
    * Table rows, ladder rows and position bars are all built in code; the columns are
      real, the rows are not.

  The stylesheet is the real one the app uses, so the preview is the actual design.
  Switch the look by changing the root's styleClass to theme-dark or theme-neon, though at
  runtime Theme.applyTo overwrites that class with whichever theme the toggle is showing.
-->

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.desktop.DesktopApp"
            prefWidth="1440" prefHeight="940" minWidth="1180" minHeight="760"
            styleClass="theme-light" stylesheets="@guessmarket.css">

    <!-- ====================== DesktopApp.wireFileBar(): REAL ======================= -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="toolstrip">
            <children>
                <Button fx:id="loadFile" text="Load File" styleClass="primary"/>

                <!-- The design's three states in one field: nothing loaded, loading, loaded. -->
                <HBox fx:id="field" spacing="8" alignment="CENTER_LEFT" styleClass="sunken"
                      minHeight="30" prefHeight="30" minWidth="0" HBox.hgrow="ALWAYS">
                    <padding><Insets top="0" right="10" bottom="0" left="10"/></padding>
                    <children>
                        <!-- loadedMark: filled from Java, not styled: DesktopApp.repaintShapes -->
                        <Circle fx:id="loadedMark" radius="8" visible="false" managed="false"/>
                        <Label fx:id="fileState" text="NO FILE LOADED" styleClass="h-tiny"/>
                        <Label fx:id="filePath" text="" styleClass="mono, faint"
                               maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"/>
                        <ProgressBar fx:id="loading" progress="0.0" visible="false" managed="false"
                                     maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="percent" text="0%" styleClass="pct" alignment="CENTER_RIGHT"
                               minWidth="38" prefWidth="38" visible="false" managed="false"/>
                    </children>
                </HBox>

                <Button fx:id="saveSession" text="Save session"/>
                <Button fx:id="loadSession" text="Load session"/>
                <Button fx:id="themeToggle" text="Light" styleClass="tiny"/>
            </children>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="tabs">
            <tabs>

                <!-- ============================================================
                     The Tab itself is real; its content below is a STAND-IN that
                     DesktopApp.start replaces with the generated EventsScreen.
                     fx:ids inside it name EventsScreen fields, and are documentation.
                     ============================================================ -->
                <Tab fx:id="eventsTab" text="Events" closable="false">
                    <content>
                        <StackPane styleClass="workspace">
                            <children>
                                <HBox spacing="14">
                                    <children>

                                        <!-- EventsScreen.buildEventList() -->
                                        <VBox styleClass="panel" minWidth="0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="panel-head">
                                                    <children>
                                                        <Label text="EVENTS" styleClass="h-caps"/>
                                                        <Region HBox.hgrow="ALWAYS"/>
                                                        <Label fx:id="eventCount" text="0" styleClass="pill, count"/>
                                                        <Region minWidth="4" prefWidth="4"/>
                                                        <Button text="Create event" styleClass="small"/>
                                                    </children>
                                                </HBox>

                                                <VBox VBox.vgrow="ALWAYS">
                                                    <children>
                                                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="subbar">
                                                            <children>
                                                                <Label text="FILTER" styleClass="h-tiny"/>
                                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                                    <children>
                                                                        <Label text="METHOD" styleClass="h-tiny"/>
                                                                        <ComboBox fx:id="methodFilter" value="All"
                                                                                  minWidth="108" prefWidth="108">
                                                                            <items>
                                                                                <FXCollections fx:factory="observableArrayList">
                                                                                    <String fx:value="All"/>
                                                                                    <String fx:value="LMSR"/>
                                                                                    <String fx:value="Order book"/>
                                                                                </FXCollections>
                                                                            </items>
                                                                        </ComboBox>
                                                                    </children>
                                                                </HBox>
                                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                                    <children>
                                                                        <Label text="STATUS" styleClass="h-tiny"/>
                                                                        <ComboBox fx:id="statusFilter" value="All"
                                                                                  minWidth="90" prefWidth="90">
                                                                            <items>
                                                                                <FXCollections fx:factory="observableArrayList">
                                                                                    <String fx:value="All"/>
                                                                                    <String fx:value="Active"/>
                                                                                    <String fx:value="Closed"/>
                                                                                </FXCollections>
                                                                            </items>
                                                                        </ComboBox>
                                                                    </children>
                                                                </HBox>
                                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                                    <children>
                                                                        <Label text="COMMISSION" styleClass="h-tiny"/>
                                                                        <ComboBox fx:id="commissionFilter" value="All"
                                                                                  minWidth="118" prefWidth="118">
                                                                            <items>
                                                                                <FXCollections fx:factory="observableArrayList">
                                                                                    <String fx:value="All"/>
                                                                                    <String fx:value="On purchase"/>
                                                                                    <String fx:value="On close"/>
                                                                                </FXCollections>
                                                                            </items>
                                                                        </ComboBox>
                                                                    </children>
                                                                </HBox>
                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                <Label fx:id="shown" text="3 of 3" styleClass="note"/>
                                                            </children>
                                                        </HBox>

                                                        <TableView fx:id="events" VBox.vgrow="ALWAYS">
                                                            <columns>
                                                                <TableColumn text="ID" prefWidth="40" sortable="false"/>
                                                                <TableColumn text="EVENT" prefWidth="150" sortable="false"/>
                                                                <TableColumn text="METHOD" prefWidth="90" sortable="false"/>
                                                                <TableColumn text="COMMISSION" prefWidth="90" sortable="false"/>
                                                                <TableColumn text="STATUS" prefWidth="72" sortable="false"/>
                                                            </columns>
                                                        </TableView>

                                                        <VBox spacing="8" styleClass="subbar">
                                                            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                                                            <children>
                                                                <Label text="SELECTED EVENT" styleClass="h-tiny"/>
                                                                <Label fx:id="previewName" text="–" styleClass="h-section"/>
                                                                <Label fx:id="previewDescription" text="" styleClass="muted"
                                                                       wrapText="true" minHeight="32"/>
                                                                <HBox spacing="18" alignment="TOP_LEFT">
                                                                    <children>
                                                                        <VBox spacing="3" minWidth="0">
                                                                            <children>
                                                                                <Label text="OWNER" styleClass="h-tiny"/>
                                                                                <Label fx:id="previewOwner" text="–" styleClass="num"/>
                                                                            </children>
                                                                        </VBox>
                                                                        <VBox spacing="3" minWidth="0">
                                                                            <children>
                                                                                <Label text="OPTIONS" styleClass="h-tiny"/>
                                                                                <Label fx:id="previewOptions" text="–" styleClass="muted"/>
                                                                            </children>
                                                                        </VBox>
                                                                        <VBox spacing="3" minWidth="0">
                                                                            <children>
                                                                                <Label text="COMMISSION" styleClass="h-tiny"/>
                                                                                <Label fx:id="previewCommission" text="–" styleClass="muted"/>
                                                                            </children>
                                                                        </VBox>
                                                                        <VBox spacing="3" minWidth="0">
                                                                            <children>
                                                                                <Label text="PARTICIPANTS" styleClass="h-tiny"/>
