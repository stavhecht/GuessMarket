                                                                            </children>
                                                                        </VBox>
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>

                                        <!-- EventsScreen.buildEventPanel() -->
                                        <VBox styleClass="panel" minWidth="0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox fx:id="titleRow" spacing="8" alignment="CENTER_LEFT"
                                                      styleClass="panel-head">
                                                    <children>
                                                        <Label fx:id="title" text="No event selected" styleClass="h-panel"/>
                                                        <Label fx:id="number" text="#01" styleClass="mono, faint"/>
                                                        <Label fx:id="statusSlot" text="Active" styleClass="pill, ok"/>
                                                        <Region HBox.hgrow="ALWAYS"/>
                                                        <Button fx:id="closeEvent" text="Close event…"
                                                                styleClass="danger, small"/>
                                                    </children>
                                                </HBox>

                                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                                                    <content>
                                                        <VBox spacing="12" styleClass="panel-body">
                                                            <children>

                                                                <!-- LmsrPane / OrderBookPane are swapped in here per event.
                                                                     One LMSR card is drawn out so the panel has a shape. -->
                                                                <StackPane fx:id="market" alignment="TOP_LEFT">
                                                                    <children>
                                                                        <HBox spacing="10">
                                                                            <children>
                                                                                <VBox styleClass="opt-card" HBox.hgrow="ALWAYS">
                                                                                    <children>
                                                                                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="opt-head">
                                                                                            <children>
                                                                                                <Label text="Option A" styleClass="opt-name"/>
                                                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                                                <Label text="0.52" styleClass="opt-price"/>
                                                                                            </children>
                                                                                        </HBox>
                                                                                        <VBox spacing="8" styleClass="opt-body">
                                                                                            <children>
                                                                                                <StackPane styleClass="meter" alignment="CENTER_LEFT">
                                                                                                    <children>
                                                                                                        <Region styleClass="meter-fill" prefWidth="120"/>
                                                                                                    </children>
                                                                                                </StackPane>
                                                                                                <HBox spacing="8" alignment="CENTER_LEFT">
                                                                                                    <children>
                                                                                                        <Label text="Shares" styleClass="kv-key"/>
                                                                                                        <Region HBox.hgrow="ALWAYS"/>
                                                                                                        <Label text="150" styleClass="kv-val"/>
                                                                                                    </children>
                                                                                                </HBox>
                                                                                            </children>
                                                                                        </VBox>
                                                                                        <HBox spacing="6" alignment="CENTER_LEFT" styleClass="opt-foot">
                                                                                            <children>
                                                                                                <TextField text="100" styleClass="mini" prefWidth="80"/>
                                                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                                                <Button text="Buy" styleClass="buy, compact"/>
                                                                                            </children>
                                                                                        </HBox>
                                                                                    </children>
                                                                                </VBox>
                                                                                <VBox styleClass="opt-card" HBox.hgrow="ALWAYS">
                                                                                    <children>
                                                                                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="opt-head">
                                                                                            <children>
                                                                                                <Label text="Option B" styleClass="opt-name"/>
                                                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                                                <Label text="0.48" styleClass="opt-price"/>
                                                                                            </children>
                                                                                        </HBox>
                                                                                        <VBox spacing="8" styleClass="opt-body">
                                                                                            <children>
                                                                                                <StackPane styleClass="meter" alignment="CENTER_LEFT">
                                                                                                    <children>
                                                                                                        <Region styleClass="meter-fill, other" prefWidth="100"/>
                                                                                                    </children>
                                                                                                </StackPane>
                                                                                                <HBox spacing="8" alignment="CENTER_LEFT">
                                                                                                    <children>
                                                                                                        <Label text="Shares" styleClass="kv-key"/>
                                                                                                        <Region HBox.hgrow="ALWAYS"/>
                                                                                                        <Label text="120" styleClass="kv-val"/>
                                                                                                    </children>
                                                                                                </HBox>
                                                                                            </children>
                                                                                        </VBox>
                                                                                        <HBox spacing="6" alignment="CENTER_LEFT" styleClass="opt-foot">
                                                                                            <children>
                                                                                                <TextField text="100" styleClass="mini" prefWidth="80"/>
                                                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                                                <Button text="Buy" styleClass="buy, compact"/>
                                                                                            </children>
                                                                                        </HBox>
                                                                                    </children>
                                                                                </VBox>
                                                                            </children>
                                                                        </HBox>
                                                                    </children>
                                                                </StackPane>

                                                                <!-- chartPanel -->
                                                                <VBox styleClass="framed">
                                                                    <children>
                                                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                                                            <padding><Insets top="8" right="10" bottom="6" left="10"/></padding>
                                                                            <children>
                                                                                <Label text="OPTION PRICE AFTER EACH TRANSACTION" styleClass="h-tiny"/>
                                                                                <HBox fx:id="chartLegend" spacing="12" alignment="CENTER_LEFT">
                                                                                    <children>
                                                                                        <HBox spacing="5" alignment="CENTER_LEFT">
                                                                                            <children>
                                                                                                <Circle radius="3.5"/>
                                                                                                <Label text="Option A" styleClass="faint"/>
                                                                                            </children>
                                                                                        </HBox>
                                                                                        <HBox spacing="5" alignment="CENTER_LEFT">
                                                                                            <children>
                                                                                                <Circle radius="3.5"/>
                                                                                                <Label text="Option B" styleClass="faint"/>
                                                                                            </children>
                                                                                        </HBox>
                                                                                    </children>
                                                                                </HBox>
                                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                                <Label fx:id="tradeCount" text="3 trades" styleClass="note"/>
                                                                            </children>
                                                                        </HBox>
                                                                        <!-- SparkChart chart = new SparkChart(150) -->
                                                                        <Pane fx:id="chart" styleClass="chart-slot"
                                                                              minHeight="150" prefHeight="150"/>
                                                                    </children>
                                                                </VBox>

                                                                <!-- participationPanel -->
                                                                <VBox styleClass="framed">
                                                                    <children>
                                                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                                                            <padding><Insets top="8" right="10" bottom="6" left="10"/></padding>
                                                                            <children>
                                                                                <Label text="PARTICIPATIONS" styleClass="h-tiny"/>
                                                                                <Label fx:id="participationCount" text="0" styleClass="pill, count"/>
                                                                            </children>
                                                                        </HBox>
                                                                        <TableView fx:id="participations" minHeight="120" prefHeight="212"
                                                                                   VBox.vgrow="ALWAYS">
                                                                            <columns>
                                                                                <TableColumn text="#" prefWidth="44" sortable="false"/>
                                                                                <TableColumn text="USER" prefWidth="110" sortable="false"/>
                                                                                <TableColumn text="OPTION" prefWidth="130" sortable="false"/>
                                                                                <TableColumn text="SHARES" prefWidth="74" sortable="false"/>
                                                                                <TableColumn text="PRICE" prefWidth="66" sortable="false"/>
                                                                                <TableColumn text="COMM." prefWidth="74" sortable="false"/>
                                                                                <TableColumn text="TOTAL" prefWidth="86" sortable="false"/>
                                                                            </columns>
                                                                        </TableView>
                                                                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="footer-strip">
                                                                            <children>
                                                                                <Label text="MM BALANCE" styleClass="h-tiny"/>
                                                                                <Label fx:id="accountBalance" text="–" styleClass="num"/>
                                                                                <Region minWidth="10" prefWidth="10"/>
                                                                                <Label text="COMMISSION" styleClass="h-tiny"/>
                                                                                <Label fx:id="commissionCollected" text="–" styleClass="num"/>
                                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                                <Label fx:id="methodNote" text="b = 100" styleClass="note"/>
                                                                            </children>
                                                                        </HBox>
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </VBox>
                                                    </content>
                                                </ScrollPane>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </StackPane>
                    </content>
                </Tab>

                <!-- ============================================================
                     Real Tab, stand-in content, replaced by the generated UsersScreen.
                     ============================================================ -->
                <Tab fx:id="usersTab" text="Users" closable="false">
                    <content>
                        <StackPane styleClass="workspace">
                            <children>
                                <HBox spacing="14">
                                    <children>

                                        <!-- UsersScreen.buildUserList() -->
                                        <VBox styleClass="panel" minWidth="300" prefWidth="300" maxWidth="300">
                                            <children>
                                                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="panel-head">
                                                    <children>
                                                        <Label text="USERS" styleClass="h-caps"/>
                                                        <Region HBox.hgrow="ALWAYS"/>
                                                        <Label fx:id="userCount" text="0" styleClass="pill, count"/>
                                                    </children>
                                                </HBox>
                                                <VBox VBox.vgrow="ALWAYS">
                                                    <children>
                                                        <TableView fx:id="users" VBox.vgrow="ALWAYS">
                                                            <columns>
                                                                <TableColumn text="USER" prefWidth="150" sortable="false"/>
                                                                <TableColumn text="BALANCE" prefWidth="110" sortable="false"/>
                                                            </columns>
                                                        </TableView>
                                                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="footer-strip">
                                                            <children>
                                                                <Label text="TOTAL HELD" styleClass="h-tiny"/>
                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                <Label fx:id="totalHeld" text="–" styleClass="num"/>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>

                                        <!-- UsersScreen.buildAccount() -->
                                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                                                    minWidth="0" HBox.hgrow="ALWAYS">
                                            <content>
                                                <VBox spacing="12">
                                                    <children>

                                                        <!-- accountHeader() -->
                                                        <VBox>
                                                            <children>
                                                                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="panel">
                                                                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                                                                    <children>
                                                                        <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
                                                                            <children>
                                                                                <HBox spacing="8" alignment="BASELINE_LEFT">
                                                                                    <children>
                                                                                        <Label fx:id="name" text="–" styleClass="h-panel"/>
                                                                                        <Label fx:id="ownerOf" text="Owner of 1" styleClass="pill, mark"/>
                                                                                    </children>
                                                                                </HBox>
                                                                                <Label fx:id="summary" text="" styleClass="faint"/>
                                                                            </children>
                                                                        </VBox>
                                                                        <VBox spacing="6" styleClass="card" minWidth="170">
                                                                            <children>
                                                                                <Label text="ACCOUNT BALANCE" styleClass="h-tiny"/>
                                                                                <Label fx:id="balance" text="–" styleClass="num-big"/>
                                                                            </children>
                                                                        </VBox>
