                                                                            <children>
                                                                                <Label text="POTENTIAL OUTCOME" styleClass="h-tiny"/>
                                                                                <HBox spacing="8" alignment="CENTER_LEFT">
                                                                                    <children>
                                                                                        <Label fx:id="potential" text="–" styleClass="num-big"/>
                                                                                        <Label fx:id="potentialDelta" text="" styleClass="mono"/>
                                                                                    </children>
                                                                                </HBox>
                                                                                <Label text="If every open trade wins" styleClass="note"/>
                                                                            </children>
                                                                        </VBox>
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </VBox>

