                                                        <VBox styleClass="panel">
                                                            <children>
                                                                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="panel-head">
                                                                    <children>
                                                                        <Label text="POSITION VALUE BY EVENT" styleClass="h-caps"/>
                                                                        <Region HBox.hgrow="ALWAYS"/>
                                                                        <HBox spacing="5" alignment="CENTER_LEFT">
                                                                            <children>
                                                                                <Circle radius="3.5"/>
                                                                                <Label text="value now" styleClass="faint"/>
                                                                            </children>
                                                                        </HBox>
                                                                        <HBox spacing="5" alignment="CENTER_LEFT">
                                                                            <children>
                                                                                <Circle radius="3.5"/>
                                                                                <Label text="if that side wins" styleClass="faint"/>
                                                                            </children>
                                                                        </HBox>
                                                                    </children>
                                                                </HBox>
                                                                <!-- bars: one track/fill pair per position, built in showBars() -->
                                                                <VBox fx:id="bars" spacing="8" minHeight="90">
                                                                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                                                                    <children>
                                                                        <VBox spacing="4">
                                                                            <children>
                                                                                <HBox spacing="8" alignment="CENTER_LEFT">
                                                                                    <children>
                                                                                        <Label text="Event · Option A" styleClass="kv-key"/>
                                                                                        <Region HBox.hgrow="ALWAYS"/>
                                                                                        <Label text="52.00" styleClass="kv-val"/>
                                                                                    </children>
                                                                                </HBox>
                                                                                <StackPane styleClass="bar-track" alignment="CENTER_LEFT">
                                                                                    <children>
                                                                                        <Region styleClass="bar-fill" prefWidth="220"/>
                                                                                    </children>
                                                                                </StackPane>
                                                                            </children>
                                                                        </VBox>
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </VBox>

                                                        <!-- tradePanel() -->
                                                        <VBox styleClass="panel">
                                                            <children>
                                                                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="panel-head">
                                                                    <children>
                                                                        <Label fx:id="tradeTitle" text="No event selected"
                                                                               styleClass="h-section"/>
                                                                        <Label fx:id="tradeStatus" text="Active" styleClass="pill, ok"/>
                                                                        <Region HBox.hgrow="ALWAYS"/>
                                                                        <Button text="Close event…" styleClass="danger, small"/>
                                                                    </children>
                                                                </HBox>

                                                                <HBox spacing="12" alignment="TOP_LEFT" styleClass="panel-body">
                                                                    <children>

                                                                        <VBox spacing="10" minWidth="0" HBox.hgrow="ALWAYS">
                                                                            <children>
                                                                                <Label fx:id="tradeDescription" text="" styleClass="muted"
                                                                                       wrapText="true"/>
                                                                                <!-- optionRows[0..1]: filled per event -->
                                                                                <HBox spacing="10">
                                                                                    <children>
                                                                                        <HBox spacing="8" alignment="CENTER_LEFT"
                                                                                              styleClass="card" HBox.hgrow="ALWAYS">
                                                                                            <children>
                                                                                                <Label text="Option A" styleClass="kv-key"/>
                                                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                                                <Label text="0.52" styleClass="kv-val"/>
                                                                                            </children>
                                                                                        </HBox>
                                                                                        <HBox spacing="8" alignment="CENTER_LEFT"
                                                                                              styleClass="card" HBox.hgrow="ALWAYS">
                                                                                            <children>
                                                                                                <Label text="Option B" styleClass="kv-key"/>
                                                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                                                <Label text="0.48" styleClass="kv-val"/>
                                                                                            </children>
                                                                                        </HBox>
                                                                                    </children>
                                                                                </HBox>
                                                                                <HBox spacing="18">
                                                                                    <children>
                                                                                        <VBox spacing="3" minWidth="0">
                                                                                            <children>
                                                                                                <Label text="COMMISSION" styleClass="h-tiny"/>
                                                                                                <Label fx:id="tradeCommission" text="–" styleClass="kv-val"/>
                                                                                            </children>
                                                                                        </VBox>
                                                                                        <VBox spacing="3" minWidth="0">
                                                                                            <children>
                                                                                                <Label text="MARKET METHOD" styleClass="h-tiny"/>
                                                                                                <Label fx:id="tradeMethod" text="–" styleClass="kv-val"/>
                                                                                            </children>
                                                                                        </VBox>
                                                                                        <VBox spacing="3" minWidth="0">
                                                                                            <children>
                                                                                                <Label text="EVENT ACCOUNT" styleClass="h-tiny"/>
                                                                                                <Label fx:id="tradeAccount" text="–" styleClass="kv-val"/>
                                                                                            </children>
                                                                                        </VBox>
                                                                                    </children>
                                                                                </HBox>
                                                                            </children>
                                                                        </VBox>

                                                                        <VBox spacing="6" styleClass="card"
                                                                              minWidth="260" prefWidth="260" maxWidth="260">
                                                                            <children>
                                                                                <Label fx:id="formTitle" text="BUY SHARES" styleClass="h-tiny"/>
                                                                                <HBox spacing="6">
                                                                                    <children>
                                                                                        <ToggleButton text="Option A" selected="true"
                                                                                                      maxWidth="1.7976931348623157E308"
                                                                                                      HBox.hgrow="ALWAYS"/>
                                                                                        <ToggleButton text="Option B"
                                                                                                      maxWidth="1.7976931348623157E308"
                                                                                                      HBox.hgrow="ALWAYS"/>
                                                                                    </children>
                                                                                </HBox>
                                                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                                                    <children>
                                                                                        <TextField fx:id="quantity" text="100"
                                                                                                   styleClass="qty" prefWidth="90"/>
                                                                                        <Label text="shares" styleClass="faint"/>
                                                                                    </children>
                                                                                </HBox>
                                                                                <HBox fx:id="limitRow" spacing="6" alignment="CENTER_LEFT">
                                                                                    <children>
                                                                                        <Label text="LIMIT PRICE" styleClass="h-tiny"/>
                                                                                        <TextField fx:id="limit" styleClass="qty" prefWidth="80"/>
                                                                                    </children>
                                                                                </HBox>
                                                                                <Region styleClass="divider"/>
                                                                                <VBox spacing="6">
                                                                                    <children>
                                                                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                                                                            <children>
                                                                                                <Label text="Shares cost" styleClass="kv-key"/>
                                                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                                                <Label fx:id="sharesCost" text="–" styleClass="kv-val"/>
                                                                                            </children>
                                                                                        </HBox>
                                                                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                                                                            <children>
                                                                                                <Label text="Commission" styleClass="kv-key"/>
                                                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                                                <Label fx:id="commission" text="–" styleClass="kv-val"/>
                                                                                            </children>
                                                                                        </HBox>
                                                                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                                                                            <children>
                                                                                                <Label text="Total" styleClass="kv-key"/>
                                                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                                                <Label fx:id="totalCost" text="–" styleClass="kv-val"/>
                                                                                            </children>
                                                                                        </HBox>
                                                                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                                                                            <children>
                                                                                                <Label text="Balance after" styleClass="kv-key"/>
                                                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                                                <Label fx:id="balanceAfter" text="–" styleClass="kv-val"/>
                                                                                            </children>
                                                                                        </HBox>
                                                                                    </children>
                                                                                </VBox>
                                                                                <Button fx:id="buy" text="Buy" styleClass="primary"
                                                                                        maxWidth="1.7976931348623157E308"/>
                                                                            </children>
                                                                        </VBox>
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </VBox>
                                            </content>
                                        </ScrollPane>
                                    </children>
                                </HBox>
                            </children>
                        </StackPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>

    <!--
      The status line, plus who commands are being issued as: REAL, injected into
      DesktopApp.status / DesktopApp.actingAs.

      The design puts the choice of user on the Users screen and nowhere else, which leaves
      the Events screen able to buy without saying on whose behalf, so the answer sits
      here, visible from both.
    -->
    <bottom>
        <HBox spacing="0" alignment="CENTER_LEFT" styleClass="statusbar">
            <children>
                <Label fx:id="status" text="Load an events file to begin." styleClass="muted"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="actingAs" text="" styleClass="note"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>